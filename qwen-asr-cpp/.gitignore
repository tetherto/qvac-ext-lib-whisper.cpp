# CMake build trees.
build/
build-*/

# Downloaded model checkpoints (large, fetched on demand).
models/
*.gguf
*.safetensors
*.bin

# Reference artifacts. We don't track .npy dumps but we do track the
# benchmark JSON snapshots so PROGRESS.md can cite before/after numbers.
artifacts/*
*.npy

!artifacts/bench/
!artifacts/bench/**

# Python virtualenvs for any one-off conversion scripts.
venv/
.venv/
.venv-*/
.pip-cache/
__pycache__/
*.pyc

# IDE / editor / OS cruft.
.DS_Store
.vscode/
.idea/
*.swp

# Third-party prebuilts: source + intermediate build + install trees are
# regenerated by scripts/build-openblas-android.sh. Keep the script tracked,
# not the artifacts (each one is tens to hundreds of MB).
vendor/openblas-android/

# Android demo: Gradle / CMake / NDK transient state and per-host paths.
examples/android-demo/.gradle/
examples/android-demo/build/
examples/android-demo/app/build/
examples/android-demo/app/.cxx/
examples/android-demo/local.properties
examples/android-demo/.idea/
examples/android-demo/captures/
examples/android-demo/.kotlin/
examples/android-demo/app/release/

# iOS demo: xcodegen output and Xcode build trees are regenerable.
examples/ios-simulator-demo/QwenAsrDemo.xcodeproj/
examples/ios-simulator-demo/build/
examples/ios-simulator-demo/DerivedData/
examples/ios-simulator-demo/*.xcworkspace/

# Bundled binary artifacts that consumers regenerate from the build scripts.
*.xcframework/
*.framework/

# adb / debug scratch outputs.
*.apk
*.aab
